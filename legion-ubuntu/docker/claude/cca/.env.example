TZ=Australia/Melbourne
DOMAIN=example.com

# Paths
# Live SQLite database lives here as cca.db (plus -wal and -shm).
CCA_DATA_PATH=/path/to/cca/data

# Litestream replica target. Keep this on a DIFFERENT physical disk to the data path.
CCA_BACKUP_PATH=/path/to/cca/backups

# Signs the anonymous profile cookie — the cookie IS the identity, so a guessable
# value lets anyone forge another profile. Generate one, do not ship this file's:
#   openssl rand -base64 48
# Left deliberately empty: compose refuses to start without it, rather than silently
# signing with a placeholder. Changing it later invalidates existing cookies and mints
# fresh profiles, so keep it stable once set.
COOKIE_SECRET=
