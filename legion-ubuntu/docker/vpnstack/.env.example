MEDIA_PATH=/local/path/to/media
OPENVPN_USER=/nordvpn/username/from/https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/service-credentials/
OPENVPN_PASSWORD=/nordvpn/password/from/https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/service-credentials/
WIREGUARD_PRIVATE_KEY=/nordvpn/wireguard/privatekey/path/from/https://my.nordaccount.com/dashboard/nordvpn/access-tokens/

# You need to set either OPENVPN_USER and OPENVPN_PASSWORD for OpenVPN
# or WIREGUARD_PRIVATE_KEY for WireGuard, depending on which VPN_TYPE you choose
# in your compose.yml file.

# Cinephage
# Holds the live SQLite database at $CINEPHAGE_CONFIG_PATH/data/cinephage.db.
CINEPHAGE_CONFIG_PATH=/path/to/cinephage/config

# Litestream replica target. Keep this on a DIFFERENT physical disk to the config path.
CINEPHAGE_BACKUP_PATH=/path/to/cinephage/backups

# Signs sessions and encrypts stored API keys. Generate with: openssl rand -base64 32
# Changing this logs everyone out and makes saved API keys unrecoverable — back it up.
BETTER_AUTH_SECRET=
