DOMAIN=example.com

# required, may need port. See gethomepage.dev/installation/#homepage_allowed_hosts
HOMEPAGE_ALLOWED_HOSTS=

# Base URL of the host itself, for services not behind Traefik (e.g. Plex).
HOMEPAGE_VAR_BASE_URL=

# Base domain used to build service links: https://<sub>.{{HOMEPAGE_VAR_DOMAIN}}
# compose.yml also sets this from ${DOMAIN}; keep the two in agreement.
HOMEPAGE_VAR_DOMAIN=${DOMAIN}

HOMEPAGE_VAR_WEATHERAPI_API_KEY=
HOMEPAGE_VAR_OPENWEATHERMAP_API_KEY=

# --- Service widget credentials -------------------------------------------
# Each of these backs a widget in config/homepage/services.yaml. Widgets other
# than Prowlarr ship commented out — fill the key, then uncomment the widget.

# docker exec prowlarr sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
HOMEPAGE_VAR_PROWLARR_API_KEY=

# qBittorrent Web UI login (the stored password is a PBKDF2 hash and cannot be
# recovered — set these to the credentials you log in with).
HOMEPAGE_VAR_QBITTORRENT_USERNAME=
HOMEPAGE_VAR_QBITTORRENT_PASSWORD=

# Jellyfin: Dashboard -> Advanced -> API Keys -> New API Key
HOMEPAGE_VAR_JELLYFIN_API_KEY=

# Immich: Account Settings -> API Keys -> New API Key
HOMEPAGE_VAR_IMMICH_API_KEY=

# Plex: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
HOMEPAGE_VAR_PLEX_TOKEN=

# Homarr encryption key (64-char hex string)
# Generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=

# Host docker group GID (getent group docker) — homepage runs as PUID and needs
# this to read /var/run/docker.sock for container status.
DOCKER_GID=
