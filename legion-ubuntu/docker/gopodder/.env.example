TZ=Australia/Melbourne
DOMAIN=example.com

# Paths
# Live SQLite database. gopodder only supports a LOCAL sqlite file here
# (driver is modernc.org/sqlite) or a postgres DSN via GOPODDER_DB_BACKEND=postgres.
# A libsql:// URL will NOT work — it is treated as a filename.
GOPODDER_DATA_PATH=/path/to/gopodder/data

# Litestream replica target. Keep this on a DIFFERENT physical disk to the data path.
GOPODDER_BACKUP_PATH=/path/to/gopodder/backups

# Logging: debug | info | warn | error
GOPODDER_LOG_LEVEL=info
