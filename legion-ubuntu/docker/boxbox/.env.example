TZ=Australia/Melbourne
DOMAIN=example.com

# JWT secret — generate with: openssl rand -base64 32
BOXBOX_JWT_SECRET=change-me-use-openssl-rand-base64-32

# Admin password (plaintext; boxbox hashes it internally)
BOXBOX_USERS_admin=change-me

# Host home directory exposed as /home/user in the container
HOME_PATH=/home/tagpro

# Optional: override individual sidebar shortcuts
# DESKTOP_PATH=/home/tagpro/Desktop
# DOWNLOADS_PATH=/home/tagpro/Downloads
# DOCUMENTS_PATH=/home/tagpro/Documents
# MUSIC_PATH=/home/tagpro/Music
# PICTURES_PATH=/home/tagpro/Pictures
# VIDEOS_PATH=/home/tagpro/Videos

# Container image (defaults to latest)
# BOXBOX_IMAGE=ghcr.io/jr4dh3y/boxbox:latest

# Auth rate limit (requests/sec per IP, 0 to disable)
BOXBOX_RATE_LIMIT_RPS=10

# Allowed WebSocket origins (empty = allow all)
BOXBOX_ALLOWED_ORIGINS=
