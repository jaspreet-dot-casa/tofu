DOMAIN=example.com

# Docker projects directory (this stack's root), mounted at the same path inside the container:
#   echo "ARCANE_PROJECTS_DIRECTORY=$(cd .. && pwd)" >> .env
ARCANE_PROJECTS_DIRECTORY=

# Encrypts secrets stored in Arcane's database (registry credentials, etc.).
# Fresh install:  docker run --rm ghcr.io/getarcaneapp/manager:v3 /app/arcane generate secret
# Upgrading:      MUST be the existing (pre-v3 ENCRYPTION_KEY) value, or stored secrets won't decrypt.
ARCANE_ENCRYPTION_KEY=

# Traefik's network, so login rate limits see the real client IP instead of Traefik's:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
ARCANE_TRUSTED_PROXIES=

# OIDC via Pocket ID (setting these locks the matching settings in the UI)
ARCANE_OIDC_ENABLED=true
ARCANE_OIDC_CLIENT_ID=
ARCANE_OIDC_CLIENT_SECRET=
ARCANE_OIDC_ISSUER_URL=https://auth.example.com
ARCANE_OIDC_SCOPES=openid email profile groups
ARCANE_OIDC_GROUPS_CLAIM=groups
# Members of the Pocket ID "admin" group get Arcane's built-in admin role
# (replaces OIDC_ADMIN_CLAIM / OIDC_ADMIN_VALUE, which 2.x and later ignore).
ARCANE_OIDC_ROLE_MAPPINGS='[{"claimValue":"admin","roleId":"role_admin"}]'
