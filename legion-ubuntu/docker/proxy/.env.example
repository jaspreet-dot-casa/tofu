# Domain configuration
DOMAIN=YOUR_DOMAIN

# Cloudflare DNS Provider Configuration
# Create API token at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:DNS:Edit, Zone:Zone:Read for your domain
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_EMAIL_ID=your_email@example.com

# Cloudflare credentials (used by Traefik)
CF_DNS_API_TOKEN=${CLOUDFLARE_API_TOKEN}
CF_API_EMAIL=${CLOUDFLARE_EMAIL_ID}

# ACME (Let's Encrypt) Configuration
ACME_EMAIL=${CLOUDFLARE_EMAIL_ID}

# Timezone
TZ=Australia/Melbourne

# User/Group IDs
PUID=1000
PGID=1000

# Pocket ID external database connection string
# e.g. postgresql://user:password@host:5432/pocketid
POCKETID_DB_CONN=

# Pocket ID encryption key
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=generate_random_encryption_key_here
